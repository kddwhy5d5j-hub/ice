  <!-- JavaScript ช่วยจำรูปพรีเซ็นเตอร์เมื่อกดอัปโหลด -->
  <script>
    const uploader = document.getElementById('imageUploader');
    const presenterImg = document.getElementById('presenterImg');

    // โหลดรูปจากหน่วยความจำเดิมถ้าเคยเลือกไว้
    const savedImg = localStorage.getItem('ichoice_presenter_img');
    if (savedImg) {
      presenterImg.src = savedImg;
    }

    // เมื่อกดเลือกรูปใหม่
    uploader.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          presenterImg.src = evt.target.result;
          localStorage.setItem('ichoice_presenter_img', evt.target.result);
        };
        reader.readAsDataURL(file);
      }
    });
  </script>

